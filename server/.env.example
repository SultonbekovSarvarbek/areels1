DATABASE_URL="postgresql://user@localhost:5432/avtolike"

API_PORT=3000
# 0.0.0.0, а не localhost: иначе до API не достучится физический телефон в той же сети
API_HOST=0.0.0.0

# MinIO — локальная замена S3. Тот же протокол, при переезде меняются только эти значения.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=listings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# База для ссылок на фото. Для физического телефона поменять на LAN-адрес машины.
S3_PUBLIC_URL=http://localhost:9000/listings

# Токен от @BotFather. Без него бот не стартует, API работает независимо.
BOT_TOKEN=

# Пароль от панели модерации (/admin). Пустой — панель отключена.
ADMIN_PASSWORD=

# Куда бот пишет о новых жалобах на объявления. Свой id можно узнать у @userinfobot.
# Пустой — жалобы всё равно сохраняются и видны в /admin, теряется только скорость.
MODERATOR_CHAT_ID=

# Адрес сервера снаружи — из него собирается ссылка на панель в уведомлении о жалобе.
PUBLIC_URL=https://yodda.online
