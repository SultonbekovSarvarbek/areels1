{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // ../src/types.ts — общий с приложением контракт домена. Файл без импортов,
  // поэтому тянется сюда напрямую и не приводит за собой типы React Native.
  "include": ["src/**/*.ts", "../src/types.ts"]
}
